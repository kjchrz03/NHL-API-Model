"""Historical daily XGBoost SHAP explanations for NHL playoff predictions.

The legacy ``playoff_shap_values`` table is not modified.
"""
from __future__ import annotations

from datetime import datetime, timezone
import re

import duckdb
import numpy as np
import pandas as pd
import shap
from joblib import load
from scipy.special import expit

from config import MODEL_PATH
from feature_engineering import build_features

FEATURE_SOURCE_TABLE = "team_daily_stats"
FEATURE_TARGET_TABLE = "playoff_shap_values_v2"

bundle = load(MODEL_PATH)
xgb_pipeline = bundle["xgb_pipeline"]
FEATURE_COLS = list(bundle["features"])
MODEL_VERSION_USED = str(bundle["version"])
xgb_model = xgb_pipeline.named_steps["model"]
scaler = xgb_pipeline.named_steps.get("scaler")

if not FEATURE_COLS or len(FEATURE_COLS) != len(set(FEATURE_COLS)):
    raise ValueError("Saved model features are empty or contain duplicates")

ID_COLS = [
    "season_id", "snapshot_date", "game_date", "team_id",
    "tri_code", "model_version", "created_at",
]
METRIC_COLS = ["shap_base_value", "xgb_raw_margin", "xgb_probability"]
SHAP_COLS = [f"shap_{feature}" for feature in FEATURE_COLS]
OUTPUT_COLS = ID_COLS + METRIC_COLS + SHAP_COLS
if len(OUTPUT_COLS) != len(set(OUTPUT_COLS)):
    raise ValueError("Output column name collision")


def _quote(name: str) -> str:
    return '"' + name.replace('"', '""') + '"'


def _table_exists(con: duckdb.DuckDBPyConnection) -> bool:
    return bool(con.execute(
        """SELECT COUNT(*) FROM information_schema.tables
           WHERE table_schema = current_schema() AND table_name = ?""",
        [FEATURE_TARGET_TABLE],
    ).fetchone()[0])


def _source_dates(con: duckdb.DuckDBPyConnection, season_id: int) -> list:
    rows = con.execute(
        f"""SELECT DISTINCT CAST(game_date AS DATE) AS snapshot_date
            FROM {_quote(FEATURE_SOURCE_TABLE)}
            WHERE season_id = ? ORDER BY 1""",
        [season_id],
    ).fetchall()
    return [row[0] for row in rows]


def _snapshot_team_counts(con: duckdb.DuckDBPyConnection, season_id: int) -> dict:
    """Count teams with at least one completed game by each NHL game date."""
    rows = con.execute(
        f"""
        WITH first_games AS (
            SELECT team_id, MIN(CAST(game_date AS DATE)) AS first_date
            FROM {_quote(FEATURE_SOURCE_TABLE)}
            WHERE season_id = ? GROUP BY team_id
        ), dates AS (
            SELECT DISTINCT CAST(game_date AS DATE) AS snapshot_date
            FROM {_quote(FEATURE_SOURCE_TABLE)} WHERE season_id = ?
        )
        SELECT d.snapshot_date, COUNT(f.team_id) AS expected_teams
        FROM dates d LEFT JOIN first_games f ON f.first_date <= d.snapshot_date
        GROUP BY d.snapshot_date ORDER BY d.snapshot_date
        """,
        [season_id, season_id],
    ).fetchall()
    return {date: int(count) for date, count in rows}


def _dates_to_process(
    con: duckdb.DuckDBPyConnection,
    season_id: int,
    snapshot_date=None,
    refresh_existing: bool = False,
) -> list:
    dates = _source_dates(con, season_id)
    if not dates:
        raise RuntimeError(f"No team-game data for season {season_id}")

    if snapshot_date is not None:
        requested = pd.Timestamp(snapshot_date).date()
        if requested not in dates:
            raise ValueError(f"{requested} is not a game date for season {season_id}")
        return [requested]

    if refresh_existing or not _table_exists(con):
        return dates

    # Verify schema before treating an existing row count as a completed snapshot.
    _validate_target_schema(con)
    counts = _snapshot_team_counts(con, season_id)
    existing = con.execute(
        f"""SELECT snapshot_date, COUNT(*) AS n,
                   COUNT(DISTINCT team_id) AS unique_teams
            FROM {_quote(FEATURE_TARGET_TABLE)}
            WHERE season_id = ? AND model_version = ?
            GROUP BY snapshot_date""",
        [season_id, MODEL_VERSION_USED],
    ).fetchall()
    stored = {date: (int(n), int(unique)) for date, n, unique in existing}
    return [
        date for date in dates
        if stored.get(date) != (counts[date], counts[date])
    ]


def _load_asof_snapshot(
    con: duckdb.DuckDBPyConnection, season_id: int, snapshot_date,
) -> pd.DataFrame:
    df = con.execute(
        f"""SELECT * FROM {_quote(FEATURE_SOURCE_TABLE)}
            WHERE season_id = ? AND CAST(game_date AS DATE) <= ?
            QUALIFY ROW_NUMBER() OVER (
                PARTITION BY team_id ORDER BY game_date DESC, game_id DESC
            ) = 1
            ORDER BY team_id""",
        [season_id, snapshot_date],
    ).df()
    if df.empty or df["team_id"].duplicated().any():
        raise RuntimeError(f"Missing or duplicated team snapshots for {snapshot_date}")
    if (pd.to_datetime(df["game_date"]).dt.date > snapshot_date).any():
        raise RuntimeError("Future-dated game included in as-of snapshot")
    return df


def _build_shap_dataframe(
    df_raw: pd.DataFrame, *, season_id: int, snapshot_date,
    explainer: shap.TreeExplainer | None = None,
) -> pd.DataFrame:
    features = build_features(df_raw.copy())
    missing = [col for col in FEATURE_COLS if col not in features.columns]
    if missing:
        raise ValueError(f"Missing saved model features: {missing}")

    X = features[FEATURE_COLS].copy().fillna(0)
    if not np.isfinite(X.to_numpy(dtype=float)).all():
        raise ValueError("SHAP feature matrix contains nonfinite values")

    if scaler is not None:
        X_in = pd.DataFrame(
            scaler.transform(X), columns=FEATURE_COLS, index=X.index,
        )
    else:
        X_in = X.copy()
    if not np.isfinite(X_in.to_numpy(dtype=float)).all():
        raise ValueError("Transformed SHAP feature matrix contains nonfinite values")

    if explainer is None:
        explainer = shap.TreeExplainer(xgb_model)
    explanation = explainer(X_in)
    values = np.asarray(explanation.values, dtype=float)
    if values.shape != (len(X), len(FEATURE_COLS)):
        raise RuntimeError(f"Unexpected SHAP matrix shape: {values.shape}")

    base = np.asarray(explanation.base_values, dtype=float)
    if base.ndim == 0:
        base = np.full(len(X), float(base))
    else:
        base = np.broadcast_to(base.reshape(-1), (len(X),))
    raw_margin = base + values.sum(axis=1)
    probability = expit(raw_margin)
    model_probability = xgb_pipeline.predict_proba(X)[:, 1]
    if not np.allclose(probability, model_probability, atol=1e-4, rtol=1e-4):
        delta = float(np.max(np.abs(probability - model_probability)))
        raise RuntimeError(f"SHAP probability reconstruction failed: {delta:.8g}")
    if not all(np.isfinite(a).all() for a in (values, base, raw_margin, probability)):
        raise RuntimeError("SHAP explanation contains nonfinite values")

    out = pd.DataFrame(index=features.index)
    out["season_id"] = int(season_id)
    out["snapshot_date"] = pd.Timestamp(snapshot_date).date()
    out["game_date"] = pd.to_datetime(features["game_date"]).dt.date
    out["team_id"] = features["team_id"].values
    out["tri_code"] = features["tri_code"].values
    out["model_version"] = MODEL_VERSION_USED
    out["created_at"] = datetime.now(timezone.utc)
    out["shap_base_value"] = base
    out["xgb_raw_margin"] = raw_margin
    out["xgb_probability"] = probability
    shap_frame = pd.DataFrame(values, columns=SHAP_COLS, index=features.index)
    out = pd.concat([out, shap_frame], axis=1)[OUTPUT_COLS]

    keys = ["season_id", "snapshot_date", "team_id", "model_version"]
    if out.duplicated(keys).any():
        raise RuntimeError("Duplicate SHAP daily snapshot keys")
    return out


def _validate_target_schema(con: duckdb.DuckDBPyConnection) -> None:
    schema = con.execute(f"DESCRIBE {_quote(FEATURE_TARGET_TABLE)}").df()
    existing = schema["column_name"].tolist()
    if existing != OUTPUT_COLS:
        missing = sorted(set(OUTPUT_COLS) - set(existing))
        extra = sorted(set(existing) - set(OUTPUT_COLS))
        raise RuntimeError(
            "Existing SHAP v2 table is incompatible with current model. "
            f"Missing columns: {missing}; unexpected columns: {extra}; "
            f"order matches: {existing == OUTPUT_COLS}. "
            "No rows have been modified."
        )


def _write_shap_dataframe(con: duckdb.DuckDBPyConnection, df: pd.DataFrame) -> None:
    if df.empty:
        return
    target = _quote(FEATURE_TARGET_TABLE)
    quoted_cols = ", ".join(_quote(col) for col in OUTPUT_COLS)
    con.register("shap_updates_v2", df)
    started = False
    try:
        con.execute("BEGIN TRANSACTION")
        started = True
        if not _table_exists(con):
            con.execute(
                f"CREATE TABLE {target} AS SELECT * FROM shap_updates_v2 WHERE 1 = 0"
            )
            con.execute(
                f"""CREATE UNIQUE INDEX shap_v2_unique_snapshot
                    ON {target} (season_id, snapshot_date, team_id, model_version)"""
            )
        _validate_target_schema(con)
        con.execute(
            f"""DELETE FROM {target}
                WHERE (season_id, snapshot_date, model_version) IN (
                    SELECT DISTINCT season_id, snapshot_date, model_version
                    FROM shap_updates_v2
                )"""
        )
        con.execute(
            f"""INSERT INTO {target} ({quoted_cols})
                SELECT {quoted_cols} FROM shap_updates_v2"""
        )
        con.execute("COMMIT")
        started = False
    except Exception:
        if started:
            con.execute("ROLLBACK")
        raise
    finally:
        con.unregister("shap_updates_v2")


def run_prediction_features(
    *,
    con: duckdb.DuckDBPyConnection,
    season_id: int,
    snapshot_date=None,
    refresh_existing: bool = False,
) -> None:
    """Generate historical daily SHAP explanations.

    Defaults to missing/incomplete game dates; a specified snapshot_date
    is recalculated even if it already exists. Set refresh_existing=True
    to recalculate all game dates for this model version.
    """
    print(f"▶ Daily SHAP | season={season_id} | model={MODEL_VERSION_USED}")
    print(f"   Target: {FEATURE_TARGET_TABLE} (legacy table untouched)")
    dates = _dates_to_process(
        con, season_id, snapshot_date=snapshot_date,
        refresh_existing=refresh_existing,
    )
    if not dates:
        print("✅ All game-date snapshots already present")
        return
    print(f"   Dates to process: {len(dates)}")
    explainer = shap.TreeExplainer(xgb_model)
    total_rows = 0
    for date in dates:
        raw = _load_asof_snapshot(con, season_id, date)
        updates = _build_shap_dataframe(
            raw, season_id=season_id, snapshot_date=date, explainer=explainer,
        )
        _write_shap_dataframe(con, updates)
        total_rows += len(updates)
        print(f"   ✓ {date}: {len(updates)} teams")
    print(f"✅ {len(dates)} dates, {total_rows:,} rows written to {FEATURE_TARGET_TABLE}")


